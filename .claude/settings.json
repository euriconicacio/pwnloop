{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./bin/pwnloop:*)",
      "Bash(bin/pwnloop:*)",
      "Bash(~/pwnloop/bin/pwnloop:*)",
      "Bash($HOME/pwnloop/bin/pwnloop:*)",
      "Bash(docker exec:*)",
      "Bash(docker start pwnloop-box)",
      "Bash(docker ps:*)",
      "Read(//Users/*/pwnloop/**)",
      "Write(//Users/*/pwnloop/engagements/**)",
      "Edit(//Users/*/pwnloop/engagements/**)"
    ],
    "deny": [
      "Bash(docker rm:*)",
      "Bash(rm -rf:*)"
    ]
  }
}
