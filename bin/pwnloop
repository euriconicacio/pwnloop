#!/usr/bin/env bash
# pwnloop — thin wrapper around the Kali lab container.
#
#   pwnloop build              rebuild the image
#   pwnloop up                 create/start the container
#   pwnloop down               stop and remove the container
#   pwnloop sh                 interactive shell inside the container
#   pwnloop x <cmd...>         run a command inside the container (non-interactive)
#   pwnloop vpn <file.ovpn>    start OpenVPN inside the container (backgrounded)
#   pwnloop vpn-status         show tun0 / HTB reachability
#   pwnloop vpn-stop           kill the VPN
#   pwnloop status             image, container, VPN and tooling summary
#   pwnloop flags              show locally captured flags
#   pwnloop banner             print the startup banner
set -euo pipefail

LAB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
IMAGE="pwnloop:latest"
NAME="pwnloop-box"

# Print the header comment block only — stop at the first non-comment line.
usage() { awk 'NR>1 { if ($0 !~ /^#/) exit; sub(/^# ?/, ""); print }' "${BASH_SOURCE[0]}"; }

# `docker inspect` also matches images, so always scope these to containers.
running() { [ "$(docker container inspect -f '{{.State.Running}}' "$NAME" 2>/dev/null || echo false)" = "true" ]; }
exists()  { docker container inspect "$NAME" >/dev/null 2>&1; }

cmd_build() {
  docker build --platform linux/arm64 -t "$IMAGE" "$LAB_DIR/docker"
}

cmd_up() {
  if exists; then
    running || docker start "$NAME" >/dev/null
  else
    mkdir -p "$LAB_DIR/engagements" "$LAB_DIR/vpn"
    docker run -d --name "$NAME" \
      --platform linux/arm64 \
      --cap-add=NET_ADMIN \
      --device /dev/net/tun \
      --dns 1.1.1.1 \
      -v "$LAB_DIR/engagements:/engagements" \
      -v "$LAB_DIR/vpn:/vpn:ro" \
      "$IMAGE" >/dev/null
  fi
  echo "container $NAME is up"
}

cmd_x() {
  running || cmd_up >/dev/null
  docker exec -w /engagements "$NAME" bash -lc "$*"
}

cmd_sh() {
  running || cmd_up >/dev/null
  docker exec -it -w /engagements "$NAME" bash -l
}

cmd_vpn() {
  local ovpn="${1:?usage: pwnloop vpn <file.ovpn>}"
  local base; base="$(basename "$ovpn")"
  [ -f "$LAB_DIR/vpn/$base" ] || { echo "put $base in $LAB_DIR/vpn/ first" >&2; exit 1; }
  running || cmd_up >/dev/null
  docker exec -d "$NAME" bash -lc \
    "openvpn --config /vpn/$base --daemon --log /tmp/openvpn.log --writepid /tmp/openvpn.pid"
  echo "openvpn starting; check with: pwnloop vpn-status"
}

cmd_vpn_status() {
  cmd_x 'ip -4 addr show tun0 2>/dev/null || echo "tun0: down"; echo "--- last log ---"; tail -n 5 /tmp/openvpn.log 2>/dev/null || true'
}

cmd_vpn_stop() { cmd_x 'pkill -F /tmp/openvpn.pid 2>/dev/null || pkill openvpn || true; echo stopped'; }

cmd_status() {
  echo "image:     $(docker images -q "$IMAGE" | head -1 || echo '<none>')"
  echo "container: $(running && echo running || echo stopped)"
  running && cmd_x 'for t in nmap ffuf feroxbuster nxc netexec impacket-secretsdump evil-winrm sqlmap hydra john searchsploit openvpn; do printf "%-22s %s\n" "$t" "$(command -v $t || echo -)"; done; echo; ip -4 addr show tun0 2>/dev/null | grep inet || echo "tun0: down"'
}

cmd_banner() {
  local A V D R
  # Colour only for a terminal — the agent captures this output as plain text.
  if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    A=$'\033[38;5;215m'; V=$'\033[38;5;203m'; D=$'\033[38;5;245m'; R=$'\033[0m'
  else
    A=''; V=''; D=''; R=''
  fi
  echo
  while IFS= read -r l; do printf '%s%s%s\n' "$A" "$l" "$R"; done <<'ART'
                                 dP
                                 88
    88d888b. dP  dP  dP 88d888b. 88 .d8888b. .d8888b. 88d888b.
    88'  `88 88  88  88 88'  `88 88 88'  `88 88'  `88 88'  `88
    88.  .88 88.88b.88' 88    88 88 88.  .88 88.  .88 88.  .88
    88Y888P' 8888P Y8P  dP    dP dP `88888P' `88888P' 88Y888P'
    88                                                88
    dP                                                dP
ART
  printf '\n    %sv1.0 by Eurico Nicacio (h3llh0und)%s\n' "$V" "$R"
  printf '    %sautonomous lab-machine engagement loop%s\n\n' "$D" "$R"
}

cmd_flags() {
  if [ -f "$LAB_DIR/flags.local.md" ]; then cat "$LAB_DIR/flags.local.md"
  else echo "no flags captured yet ($LAB_DIR/flags.local.md)"; fi
}

case "${1:-}" in
  build) shift; cmd_build "$@" ;;
  up) shift; cmd_up "$@" ;;
  down) docker rm -f "$NAME" >/dev/null 2>&1 && echo "removed" ;;
  sh) shift; cmd_sh "$@" ;;
  x) shift; cmd_x "$@" ;;
  vpn) shift; cmd_vpn "$@" ;;
  vpn-status) cmd_vpn_status ;;
  vpn-stop) cmd_vpn_stop ;;
  status) cmd_status ;;
  flags) cmd_flags ;;
  banner) cmd_banner ;;
  *) usage ;;
esac
