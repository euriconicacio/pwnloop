#!/usr/bin/env bash
# pwnloop — thin wrapper around the Kali lab container.
#
#   pwnloop build              rebuild the image
#   pwnloop up                 create/start the container
#   pwnloop down               stop and remove the container
#   pwnloop sh                 interactive shell inside the container
#   pwnloop x <cmd...>         run a command inside the container (non-interactive)
#   pwnloop vpn <file.ovpn>    start OpenVPN inside the container (backgrounded)
#   pwnloop vpn-status         show tun0 / HTB reachability
#   pwnloop vpn-stop           kill the VPN
#   pwnloop status             image, container, VPN and tooling summary
#   pwnloop flags              show locally captured flags
#   pwnloop engagements        list past engagements and what each one was
#   pwnloop banner             print the startup banner
#   pwnloop ship [msg]         commit and push your learnings to your own remote
#   pwnloop backup [--full]    encrypted archive of what git does not track
#   pwnloop audit [base]       what a release must never carry — run before push
#
# Multi-host campaigns (Pro Labs) — state store, see bin/lib/campaign.sh:
#   pwnloop campaign <new|use|list|status|resume|sync|dir>
#   pwnloop host <add|set|list|show>
#   pwnloop cred <add|list>
#   pwnloop try <cred> <host> <service> <ok|fail|locked|error> | try next [n]
#   pwnloop route <add|del|list|check>
#   pwnloop flag <host> <name> <value>
#   pwnloop lead <add|list|done|dead>
set -euo pipefail

LAB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
IMAGE="pwnloop:latest"
NAME="pwnloop-box"

# Print the header comment block only — stop at the first non-comment line.
usage() { awk 'NR>1 { if ($0 !~ /^#/) exit; sub(/^# ?/, ""); print }' "${BASH_SOURCE[0]}"; }

# `docker inspect` also matches images, so always scope these to containers.
running() { [ "$(docker container inspect -f '{{.State.Running}}' "$NAME" 2>/dev/null || echo false)" = "true" ]; }
exists()  { docker container inspect "$NAME" >/dev/null 2>&1; }

cmd_build() {
  docker build --platform linux/arm64 -t "$IMAGE" "$LAB_DIR/docker"
}

cmd_up() {
  if exists; then
    running || docker start "$NAME" >/dev/null
    # A container created before campaign mode has no /campaigns mount, and a
    # bind mount cannot be added to a live container.
    docker container inspect -f '{{range .Mounts}}{{.Destination}} {{end}}' "$NAME" \
      | grep -q /campaigns || {
      echo "note: this container predates campaign mode and has no /campaigns mount." >&2
      echo "      run 'pwnloop down && pwnloop up' before starting a campaign." >&2
    }
  else
    mkdir -p "$LAB_DIR/engagements" "$LAB_DIR/campaigns" "$LAB_DIR/vpn"
    docker run -d --name "$NAME" \
      --platform linux/arm64 \
      --cap-add=NET_ADMIN \
      --device /dev/net/tun \
      --dns 1.1.1.1 \
      -v "$LAB_DIR/engagements:/engagements" \
      -v "$LAB_DIR/campaigns:/campaigns" \
      -v "$LAB_DIR/vpn:/vpn:ro" \
      "$IMAGE" >/dev/null
  fi
  echo "container $NAME is up"
}

cmd_x() {
  running || cmd_up >/dev/null
  docker exec -w /engagements "$NAME" bash -lc "$*"
}

cmd_sh() {
  running || cmd_up >/dev/null
  docker exec -it -w /engagements "$NAME" bash -l
}

cmd_vpn() {
  local ovpn="${1:?usage: pwnloop vpn <file.ovpn>}"
  local base; base="$(basename "$ovpn")"
  [ -f "$LAB_DIR/vpn/$base" ] || { echo "put $base in $LAB_DIR/vpn/ first" >&2; exit 1; }
  running || cmd_up >/dev/null
  docker exec -d "$NAME" bash -lc \
    "openvpn --config /vpn/$base --daemon --log /tmp/openvpn.log --writepid /tmp/openvpn.pid"
  echo "openvpn starting; check with: pwnloop vpn-status"
}

cmd_vpn_status() {
  cmd_x 'ip -4 addr show tun0 2>/dev/null || echo "tun0: down"; echo "--- last log ---"; tail -n 5 /tmp/openvpn.log 2>/dev/null || true'
}

cmd_vpn_stop() { cmd_x 'pkill -F /tmp/openvpn.pid 2>/dev/null || pkill openvpn || true; echo stopped'; }

cmd_status() {
  echo "image:     $(docker images -q "$IMAGE" | head -1 || echo '<none>')"
  echo "container: $(running && echo running || echo stopped)"
  running && cmd_x 'for t in nmap ffuf feroxbuster nxc netexec impacket-secretsdump evil-winrm sqlmap hydra john searchsploit openvpn; do printf "%-22s %s\n" "$t" "$(command -v $t || echo -)"; done; echo; ip -4 addr show tun0 2>/dev/null | grep inet || echo "tun0: down"'
}

# Encrypted backup of everything this clone knows that git does not.
#
# The intuition is that none of this needs backing up, and for most of the bytes
# that is right: an engagement's durable half is its write-up, which is already
# published in the repository. Two things break that rule and they are the two
# with no replication path at all — `memory/local.md`, which is the entire
# second loop, and `campaigns/`, which by design produces no publishable
# artifact and is therefore its own only record.
#
# Encrypted because the same archive holds flags, credentials and loot, and
# unencrypted backups of those end up on cloud drives. `vpn/` is never included:
# it is re-downloadable from the platform and is the one thing whose leak costs
# something.
cmd_backup() {
  local full=0
  [ "${1:-}" = "--full" ] && { full=1; shift; }
  local dest="${1:-$HOME/pwnloop-backups}"

  [ -t 0 ] || { echo "run this from a terminal — it prompts for a passphrase" >&2; exit 1; }

  # An archive of flags and loot inside the repository is one `git add -A` away
  # from being committed, whatever the hook says.
  case "$(cd "$dest" 2>/dev/null && pwd || echo "$dest")" in
    "$LAB_DIR"|"$LAB_DIR"/*) echo "refusing to write the backup inside the repository" >&2; exit 1 ;;
  esac

  # LibreSSL (/usr/bin/openssl on macOS) has no -pbkdf2, which would leave the
  # passphrase stretched by a single MD5 pass.
  local ssl; ssl=$(command -v openssl) || { echo "openssl not found" >&2; exit 1; }
  "$ssl" enc -help 2>&1 | grep -q -- -pbkdf2 || {
    echo "this openssl has no -pbkdf2 (LibreSSL?). Install one: brew install openssl" >&2; exit 1; }

  mkdir -p "$dest"
  local stamp; stamp=$(date -u '+%Y-%m-%d-%H%M')
  local out="$dest/pwnloop-$stamp.tar.gz"

  local items=() skipped=()
  for f in memory/local.md flags.local.md docker/packages.local.txt campaigns; do
    [ -e "$LAB_DIR/$f" ] && items+=("$f") || skipped+=("$f")
  done
  if [ "$full" -eq 1 ]; then
    [ -d "$LAB_DIR/engagements" ] && items+=("engagements")
  fi
  [ ${#items[@]} -gt 0 ] || { echo "nothing to back up" >&2; exit 1; }

  echo "archiving: ${items[*]}"
  tar czf "$out" -C "$LAB_DIR" \
      --exclude='vpn' --exclude='*.ovpn' --exclude='.DS_Store' "${items[@]}" || {
    rm -f "$out"; echo "tar failed" >&2; exit 1; }

  # openssl enc gives confidentiality but no integrity, so the plaintext digest
  # is kept beside the archive: it is what tells you a restore is intact.
  shasum -a 256 "$out" | awk '{print $1}' > "$out.sha256"

  echo "encrypting (passphrase is asked twice, and cannot be recovered):"
  "$ssl" enc -aes-256-cbc -pbkdf2 -iter 600000 -salt -in "$out" -out "$out.enc" || {
    rm -f "$out" "$out.enc" "$out.sha256"; echo "encryption failed — nothing written" >&2; exit 1; }
  rm -f "$out"

  echo
  echo "wrote $out.enc ($(du -h "$out.enc" | cut -f1))"
  echo "     $(basename "$out").sha256  — digest of the archive inside"
  [ ${#skipped[@]} -gt 0 ] && echo "not present, so not included: ${skipped[*]}"
  [ "$full" -eq 1 ] || echo "engagements/ excluded (write-ups already cover them) — use --full to include"
  echo "vpn/ excluded, always."
  echo
  echo "restore:"
  echo "  openssl enc -d -aes-256-cbc -pbkdf2 -iter 600000 -in $(basename "$out").enc -out restored.tar.gz"
  echo "  shasum -a 256 -c <(echo \"\$(cat $(basename "$out").sha256)  restored.tar.gz\")"
  echo "  tar xzf restored.tar.gz"
}

# What a release must never carry, checked before it is pushed rather than after.
#
# The pre-commit hook guards `git commit`. It does not run on `git merge`, which
# is exactly how a release reaches main — so without this the last mile of every
# release is unguarded. Run it before merging and before tagging.
#
# Hard failures are things that must never be public: engagement paths, flag
# values, private keys, the attacker's VPN address, and whatever local terms you
# listed in .redact.local (lab domains, hostnames, machine names — that file is
# gitignored, because a list of what must not leak would itself leak it).
#
# Review items are softer: the words steer/hint/walkthrough legitimately appear
# in the methodology *as rules about disclosure*, and illegitimately if a run
# ever wrote down that it was helped. No pattern can tell those apart, so they
# are printed for a human to read rather than blocked.
cmd_audit() {
  cd "$LAB_DIR" || exit 1
  local base="${1:-main}"
  git rev-parse --verify -q "$base" >/dev/null || { echo "no such ref: $base" >&2; exit 1; }

  local hard=0 review=0 added files
  files=$(git diff --name-only "$base"...HEAD)
  added=$(git diff "$base"...HEAD -- . | grep '^+' | grep -v '^+++' || true)

  echo "auditing $base...HEAD — $(printf '%s' "$files" | grep -c . || true) file(s)"
  echo

  _hard() { printf '\033[31mFAIL\033[0m  %s\n' "$1"; hard=$((hard + 1)); }
  _rev()  { printf '\033[33mREVIEW\033[0m %s\n' "$1"; review=$((review + 1)); }

  # 1. Paths that are never published, whether or not .gitignore is intact.
  local p
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    case "$p" in
      engagements/*|campaigns/*|vpn/*|flags.local.md|*.ovpn|memory/local.md|docker/packages.local.txt|.redact.local)
        _hard "engagement data in the diff: $p" ;;
    esac
  done <<< "$files"

  # Same, for anything already tracked — a file committed before the ignore rule
  # existed stays tracked and stops showing up in diffs.
  local tracked; tracked=$(git ls-files engagements campaigns vpn flags.local.md 2>/dev/null)
  [ -n "$tracked" ] && while IFS= read -r p; do
    [ -n "$p" ] && _hard "tracked engagement data: $p"
  done <<< "$tracked"

  # 2. Flag-shaped strings, minus the documented placeholders.
  local hits
  hits=$(printf '%s\n' "$added" | grep -oE '\b[0-9a-f]{32}\b' \
         | grep -vE '^(0123456789abcdef0123456789abcdef|(.)\2{31})$' | sort -u || true)
  [ -n "$hits" ] && while IFS= read -r p; do
    [ -n "$p" ] && _hard "flag- or hash-shaped value: $p"
  done <<< "$hits"

  # 3. Key material and the attacker's own address.
  printf '%s\n' "$added" | grep -q 'BEGIN [A-Z ]*PRIVATE KEY' && _hard "private key material"
  hits=$(printf '%s\n' "$added" | grep -oE '\b10\.10\.1[45]\.[0-9]{1,3}\b' | grep -v '10.10.14.x' | sort -u || true)
  [ -n "$hits" ] && while IFS= read -r p; do
    [ -n "$p" ] && _hard "attacker VPN address: $p (generalise to 10.10.14.x)"
  done <<< "$hits"

  # 4. The operator's own blocklist.
  if [ -f "$LAB_DIR/.redact.local" ]; then
    local term
    while IFS= read -r term; do
      case "$term" in ''|'#'*) continue ;; esac
      printf '%s\n' "$added" | grep -qiE "$term" && _hard "blocked term from .redact.local: $term"
    done < "$LAB_DIR/.redact.local"
  else
    _rev "no .redact.local — lab domains and hostnames are not being checked"
  fi

  # 5. Language that may describe assistance rather than methodology.
  hits=$(git diff "$base"...HEAD -- . | grep '^+' | grep -v '^+++' \
         | grep -inE 'steer|hint|walkthrough|recognition|prior knowledge|you (said|told|asked|suggested)' || true)
  if [ -n "$hits" ]; then
    _rev "$(printf '%s\n' "$hits" | wc -l | tr -d ' ') line(s) mention steer/hint/recognition — confirm each states a rule rather than a disclosure:"
    printf '%s\n' "$hits" | cut -c1-120 | sed 's/^/        /'
  fi

  echo
  if [ "$hard" -gt 0 ]; then
    echo "$hard hard failure(s). Do not push."
    exit 1
  fi
  echo "no hard failures. $review item(s) to read before pushing."
}

# Commit and push what your engagements taught this clone, to your own remote.
cmd_ship() {
  cd "$LAB_DIR" || exit 1
  git rev-parse --git-dir >/dev/null 2>&1 || { echo "not a git repository" >&2; exit 1; }
  local remote; remote=$(git remote 2>/dev/null | head -1)
  [ -n "$remote" ] || { echo "no git remote configured — fork the repo and 'git remote add origin <your-fork>'" >&2; exit 1; }

  # The two files carrying your learnings are gitignored by default, so they
  # need -f. Everything else is picked up normally.
  git add -f memory/local.md docker/packages.local.txt 2>/dev/null || true
  git add -A

  local staged; staged=$(git diff --cached --name-only)
  [ -n "$staged" ] || { echo "nothing to ship — no changes since the last one"; exit 0; }

  echo "shipping to $remote/$(git rev-parse --abbrev-ref HEAD):"
  echo "$staged" | sed 's/^/  /'

  # Refuse engagement data outright, whatever the hook is doing.
  if echo "$staged" | grep -qE '^engagements/|^campaigns/|^vpn/|flags\.local\.md|\.ovpn$'; then
    echo >&2; echo "refusing: engagement data is staged. Unstage it and check .gitignore." >&2
    git reset -q; exit 1
  fi

  local msg="${1:-Learnings from local engagements}"
  git commit -q -m "$msg" || { echo "commit refused — see the pre-commit output above" >&2; exit 1; }
  git push -q "$remote" HEAD && echo && echo "pushed. $(git log --oneline -1)"

  if git diff HEAD~1 --name-only 2>/dev/null | grep -q '^memory/local.md'; then
    echo
    echo "memory/local.md changed. If any of those entries generalise beyond your"
    echo "own lab, open a PR moving them into memory/patterns.md — that is how the"
    echo "shared methodology improves from other people's runs."
  fi
}

# Every line of the banner starts with a border glyph on purpose. The art used
# to position its top two rows with leading whitespace alone, and anything that
# re-renders this output — an agent transcript, a chat client, a markdown
# viewer — is free to trim leading whitespace at a block boundary, which
# dropped the top of the "p" to column 0. A frame makes column 0 printable, so
# there is no leading whitespace left to lose.
cmd_banner() {
  local A B V D R ver bar l
  # Colour only for a terminal — the agent captures this output as plain text.
  if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    A=$'\033[38;5;215m'; B=$'\033[38;5;240m'; V=$'\033[38;5;203m'
    D=$'\033[38;5;245m'; R=$'\033[0m'
  else
    A=''; B=''; V=''; D=''; R=''
  fi
  ver=$(cat "$LAB_DIR/VERSION" 2>/dev/null || echo "dev")

  # Art is 58 columns wide; the frame pads it to 62 and draws the edges.
  bar='──────────────────────────────────────────────────────────────'
  _banner_row() { printf '%s│  %s%-58s%s  │%s\n' "$B" "$1" "$2" "$B" "$R"; }

  echo
  printf '%s┌%s┐%s\n' "$B" "$bar" "$R"
  while IFS= read -r l; do _banner_row "$A" "$l"; done <<'ART'
                             dP
                             88
88d888b. dP  dP  dP 88d888b. 88 .d8888b. .d8888b. 88d888b.
88'  `88 88  88  88 88'  `88 88 88'  `88 88'  `88 88'  `88
88.  .88 88.88b.88' 88    88 88 88.  .88 88.  .88 88.  .88
88Y888P' 8888P Y8P  dP    dP dP `88888P' `88888P' 88Y888P'
88                                                88
dP                                                dP
ART
  _banner_row '' ''
  _banner_row "$V" "v${ver} by Eurico Nicacio (h3llh0und)"
  _banner_row "$D" 'autonomous lab-machine engagement loop'
  printf '%s└%s┘%s\n\n' "$B" "$bar" "$R"
}

# Directories are named after the address, which is precise during a run and
# useless as an archive key months later. Derive the index from what each ledger
# already recorded rather than maintaining a second file that can go stale.
cmd_engagements() {
  local d led
  printf '%-22s %-34s %-7s %s\n' DIRECTORY TARGET FLAGS STARTED
  for d in "$LAB_DIR"/engagements/*/; do
    led="$d/FINDINGS.md"; [ -f "$led" ] || continue
    local title started u r
    title=$(head -1 "$led" | sed 's/^#\{1,\} *//')
    started=$(grep -m1 -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}' "$led" || echo '?')
    grep -q '^- \[x\] user\.txt' "$led" && u=user || u=—
    grep -q '^- \[x\] root\.txt' "$led" && r=root || r=—
    printf '%-22s %-34s %-7s %s\n' "$(basename "$d")" "${title:0:34}" "$u/$r" "$started"
  done
}

cmd_flags() {
  if [ -f "$LAB_DIR/flags.local.md" ]; then cat "$LAB_DIR/flags.local.md"
  else echo "no flags captured yet ($LAB_DIR/flags.local.md)"; fi
}

# Campaign state lives in its own file: it is a third of this script's size and
# only a multi-host engagement ever touches it.
# shellcheck source=lib/campaign.sh
. "$LAB_DIR/bin/lib/campaign.sh"

case "${1:-}" in
  build) shift; cmd_build "$@" ;;
  up) shift; cmd_up "$@" ;;
  down) docker rm -f "$NAME" >/dev/null 2>&1 && echo "removed" ;;
  sh) shift; cmd_sh "$@" ;;
  x) shift; cmd_x "$@" ;;
  vpn) shift; cmd_vpn "$@" ;;
  vpn-status) cmd_vpn_status ;;
  vpn-stop) cmd_vpn_stop ;;
  status) cmd_status ;;
  flags) cmd_flags ;;
  engagements) cmd_engagements ;;
  banner) cmd_banner ;;
  ship) shift; cmd_ship "$@" ;;
  backup) shift; cmd_backup "$@" ;;
  audit) shift; cmd_audit "$@" ;;
  campaign) shift; cmd_campaign "$@" ;;
  host) shift; cmd_host "$@" ;;
  cred) shift; cmd_cred "$@" ;;
  try) shift; cmd_try "$@" ;;
  route) shift; cmd_route "$@" ;;
  flag) shift; flag_add "$@" ;;
  lead) shift; cmd_lead "$@" ;;
  *) usage ;;
esac
