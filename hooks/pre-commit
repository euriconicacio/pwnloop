#!/usr/bin/env bash
# Block engagement data from entering the repository.
#
# The risk this guards against is not an outsider — it is the maintainer
# committing output from a live engagement. GitHub's secret scanning does not
# recognise a 32-hex flag or a machine password as a secret, so this runs first.
#
# Installed by install.sh. Bypass with `git commit --no-verify` if you are
# certain (for example, adding a placeholder to a reference file).
set -uo pipefail

fail=0
note() { printf '\033[31mpre-commit:\033[0m %s\n' "$1" >&2; fail=1; }

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

# 1. Paths that must never be tracked, even if .gitignore is edited.
while IFS= read -r f; do
  case "$f" in
    engagements/*|vpn/*|flags.local.md|*.ovpn)
      note "refusing to commit engagement data: $f" ;;
  esac
done <<< "$staged"

# 2. Flag-shaped strings: exactly 32 hex characters, standalone.
#    Placeholders like <32-hex-flag> and 0123456789abcdef… are intentionally
#    allowed; a real flag is not a repeating or sequential pattern.
flags=$(git diff --cached -U0 -- $staged 2>/dev/null \
  | grep '^+' | grep -oE '\b[0-9a-f]{32}\b' \
  | grep -vE '^(0123456789abcdef0123456789abcdef|(.)\2{31})$' | sort -u)
if [ -n "$flags" ]; then
  while IFS= read -r h; do note "possible flag value in staged diff: $h"; done <<< "$flags"
  note "if this is an example, use <32-hex-flag> instead"
fi

# 3. Private key material.
if git diff --cached -U0 -- $staged 2>/dev/null | grep -q '^+.*BEGIN [A-Z ]*PRIVATE KEY'; then
  note "private key material in staged diff"
fi

# 4. Attacker VPN address — an engagement property, not a machine property.
vpn=$(git diff --cached -U0 -- $staged 2>/dev/null \
  | grep '^+' | grep -oE '\b10\.10\.1[45]\.[0-9]{1,3}\b' | grep -v '10.10.14.x' | sort -u)
if [ -n "$vpn" ]; then
  while IFS= read -r a; do note "attacker VPN address in staged diff: $a (generalise to 10.10.14.x)"; done <<< "$vpn"
fi

if [ "$fail" -ne 0 ]; then
  echo "commit blocked — see above, or use --no-verify if you are sure" >&2
  exit 1
fi
exit 0
